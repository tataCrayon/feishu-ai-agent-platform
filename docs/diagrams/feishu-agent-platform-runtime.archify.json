  "cards": [
    {
      "dot": "cyan",
      "title": "能力 = 技能目录 + MCP 工具",
      "items": [
        "技能目录只放「名字 + 描述」进路由候选集，是白名单同步产物；个人 ~/.agents/skills 不加载",
        "执行靠 MCP 工具：capabilities 把 Handler 的 tools 原样投影，schema 不重推",
        "两者任一缺失，模型都会如实回答「本会话没有这个执行入口」"
      ]
    },
    {
      "dot": "emerald",
      "title": "三层隔离",
      "items": [
        "引擎：仓库 node_modules 钉版本，桌面版升级不影响线上",
        "运行目录：独立 DSH_HOME + DSH_AGENTS_HOME，不读 ~/.agents/AGENTS.md",
        "会话指令唯一来源是 app/dsh/routing.py，agent-instructions 整插件禁用"
      ]
    },
    {
      "dot": "amber",
      "title": "旁路不抢路由",
      "items": [
        "CMDB 提醒 / PRD 监听 / 定时调度在 main.py 旁路运行，不进消息路由",
        "授权群的非 @ 消息只进监听窗口，避免把同事闲聊送去作答",
        "审批门照旧：定时任务创建必发 L2 卡片，订阅只绑发送者本人"
      ]
    }
