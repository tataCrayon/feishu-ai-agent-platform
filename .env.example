# 环境变量样例 — 复制成 .env 后填值（.env 已 gitignore，绝不入库）

# ── 编排层 LLM（路由/自答/任务分解）──
LLM_MODEL=glm-5.3-flash
LLM_BASE_URL=https://aigw.example.com/v1
LLM_API_KEY=

# ── dsh 执行面 ──
# 与 LLM_API_KEY 可以是同一把 key；留空会回落到 config.toml 的 api_key，
# 两者都空时 dsh 启动会报 no credential。
# 注意不能用 DSH_ 前缀：dsh 把该前缀视为启动环境专属，.env 里出现会直接拒绝启动。
AIGW_API_KEY=

# ── 飞书 ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
CC_WEBHOOK_TOKEN=

# ── 外部能力（按需填，不接就保持空）──
# 每个能力自己的第三方凭证都在本文件追加一行，代码里只读 env、不落配置。
# 例：某个 MCP server 需要 token → 在这里加 XXX_API_KEY，config.toml 里写 ${XXX_API_KEY}。
